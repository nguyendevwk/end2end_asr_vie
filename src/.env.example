# Voice Agent Environment Variables
# Copy this file to .env and fill in the values

# === Server ===
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false

# === Service Toggles (for testing / OOM prevention) ===
# Disable services to test individual components or save GPU memory
VAD_ENABLED=true
ASR_ENABLED=true
TTS_ENABLED=true
LLM_ENABLED=true

# Example: Test VAD only (no GPU models)
# VAD_ENABLED=true
# ASR_ENABLED=false
# TTS_ENABLED=false
# LLM_ENABLED=false

# Example: Test VAD + ASR only (~3GB VRAM)
# VAD_ENABLED=true
# ASR_ENABLED=true
# TTS_ENABLED=false
# LLM_ENABLED=false

# === LLM (Groq API) ===
# Get your API key from https://console.groq.com/
GROQ_API_KEY=your_api_key_here

# Optional: Use different LLM provider
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=512

# === ASR ===
# ASR_MODEL=Qwen/Qwen3-ASR-0.6B
# ASR_LANGUAGE=  # Empty for auto-detect, or "Vietnamese", "English", etc.
# ASR_GPU_MEMORY=0.3  # GPU memory utilization (0.0-1.0)
# ASR_BACKEND=transformers  # "transformers" (less VRAM, ~3GB) or "vllm" (faster, ~6GB+)

# ASR Optimization - Improve accuracy and speed
# ASR_PREPROCESS=true  # Enable audio preprocessing (DC removal, trim silence, pre-emphasis)
# ASR_STREAMING=false  # Enable streaming ASR for lower latency (splits audio into 2s chunks)

# === TTS ===
# TTS_MODEL=g-group-ai-lab/gwen-tts-0.6B
# TTS_TEMPERATURE=0.3

# Voice Cloning (optional)
# TTS_VOICE_REF_AUDIO=assets/voices/custom.wav
# TTS_VOICE_REF_TEXT=Transcript of the reference audio

# === VAD ===
# VAD_THRESHOLD=0.5
# VAD_MIN_SPEECH_MS=250
# VAD_MIN_SILENCE_MS=700

# === Audio ===
# SAMPLE_RATE=16000
# CHUNK_DURATION_MS=100

# === Text task (ASR -> TTS core, LLM as pluggable middleware) ===
# TEXT_TASK=llm  # 'llm' | 'passthrough' (no LLM) | 'router' | custom registered name
# TEXT_TASK_PREFIX=Bạn nói:

# === Production: concurrency & backpressure ===
# MAX_CCU=50  # Max concurrent WebSocket connections (1013 shed when full)
# MAX_INFLIGHT_INFER=4  # Max concurrent GPU inferences

# === Production: timeouts & retries ===
# ASR_TIMEOUT_S=15.0
# TTS_TIMEOUT_S=20.0
# LLM_TIMEOUT_S=30.0
# LLM_FIRST_TOKEN_TIMEOUT_S=10.0
# MAX_RETRIES=1

# === Production: heartbeat & reconnect ===
# WS_PING_INTERVAL_S=20.0
# WS_PING_TIMEOUT_S=60.0
# SESSION_TTL_S=300.0  # Reconnect resume window
